        "import re\n",
        "import string\n",
        "import pandas as pd\n",
        "\n",
        "# 1. Fungsi Pembersihan (Tanpa Case Folding)\n",
        "def clean_text_no_folding(text):\n",
        "    text = str(text)\n",
        "    text = re.sub(r'http\\S+', '', text) # Hapus URL\n",
        "    text = re.sub(r'@\\w+', '', text)    # Hapus Mention\n",
        "    text = re.sub(r'#\\w+', '', text)    # Hapus Hashtag\n",
        "    text = re.sub(r'\\d+', '', text)     # Hapus Angka\n",
        "    text = text.translate(str.maketrans('', '', string.punctuation)) # Hapus Tanda Baca\n",
        "    text = text.strip()\n",
        "    return text\n",
        "\n",
        "# 2. Eksekusi Pembersihan ke kolom baru\n",
        "df['clean_text'] = df['full_text'].apply(clean_text_no_folding)\n",
        "\n",
        "# 3. Mengambil Sampel 5 Data Positif dan 5 Data Negatif\n",
        "df_positif_sample = df[df['label'].str.lower() == 'positif'].head(5)\n",
        "df_negatif_sample = df[df['label'].str.lower() == 'negatif'].head(5)\n",
        "\n",
        "# 4. Menggabungkan kedua sampel menjadi SATU tabel tunggal\n",
        "# Kita gunakan reset_index agar urutan nomor barisnya rapi (0-9)\n",
        "df_combined_sample = pd.concat([df_positif_sample, df_negatif_sample]).reset_index(drop=True)\n",
        "\n",
