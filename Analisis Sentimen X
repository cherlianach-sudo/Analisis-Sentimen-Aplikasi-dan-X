        "!pip install Sastrawi\n",
        "from Sastrawi.Stemmer.StemmerFactory import StemmerFactory\n",
        "import pandas as pd\n",
        "\n",
        "# 1. Inisialisasi Stemmer Sastrawi\n",
        "factory = StemmerFactory()\n",
        "stemmer = factory.create_stemmer()\n",
        "\n",
        "# 2. Fungsi Stemming yang Dioptimasi\n",
        "def stemming_func(token_list):\n",
        "    # Jika input bukan list atau kosong, kembalikan list kosong\n",
        "    if not isinstance(token_list, list) or not token_list:\n",
        "        return []\n",
        "\n",
        "    # Sastrawi membutuhkan input berupa string (kalimat)\n",
        "    sentence = \" \".join(token_list)\n",
        "\n",
        "    # Proses pencarian kata dasar (misal: \"anjinggggg\" -> \"anjing\", \"ngisep\" -> \"isap\")\n",
        "    stemmed_sentence = stemmer.stem(sentence)\n",
        "\n",
        "    # Kembalikan ke bentuk list (token) agar konsisten dengan tahap sebelumnya\n",
        "    return stemmed_sentence.split()\n",
        "\n",
        "# 3. Menerapkan Stemming pada data Whippink\n",
        "print(\"Sedang memproses Stemming... Proses ini mungkin memakan waktu 1-2 menit untuk 500 data.\")\n",
