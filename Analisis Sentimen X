        "# 2. Menangani Missing Values & Penyelarasan Label\n",
        "# Pastikan kolom label Anda bernama 'label' (sesuai tahap sebelumnya)\n",
        "df = df.dropna(subset=['Text_Final', 'label'])\n",
        "\n",
        "# 3. Inisialisasi TF-IDF & Label\n",
        "# TF-IDF mengubah teks bersih menjadi angka bobot untuk Random Forest\n",
        "tfidf_vectorizer = TfidfVectorizer()\n",
        "X = tfidf_vectorizer.fit_transform(df['Text_Final'])\n",
        "y = df['label']\n",
        "\n",
        "# 4. Split Data (80% Training, 20% Testing)\n",
        "# stratify=y sangat penting agar proporsi Positif & Negatif seimbang di kedua set\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
