        "def safe_join(x):\n",
        "    if isinstance(x, str):\n",
        "        try:\n",
        "            # Mengubah string list \"['kata', 'dasar']\" menjadi \"kata dasar\"\n",
        "            actual_list = ast.literal_eval(x)\n",
        "            return ' '.join(actual_list)\n",
        "        except:\n",
        "            return x\n",
        "    return ' '.join(x) if isinstance(x, list) else str(x)\n",
        "\n",
        "# Membuat kolom final untuk modeling\n",
        "df['Text_Final'] = df['Stemming'].apply(safe_join)\n",
