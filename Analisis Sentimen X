      "source": [
        "import nltk\n",
        "import pandas as pd\n",
        "from nltk.corpus import stopwords\n",
        "\n",
        "# 1. Persiapan Stopwords Dasar\n",
        "nltk.download('stopwords')\n",
        "list_stopwords = set(stopwords.words('indonesian'))\n",
        "\n",
        "# 2. Tambahan Stopwords Spesifik (Noise Twitter & Brand)\n",
        "additional_stopwords = {\n",
        "    \"whippink\", \"whip\", \"pink\", \"twitter\", \"x\", \"platform\", \"fess\", \"base\",\n",
        "    \"yg\", \"dg\", \"sdh\", \"bgt\", \"udah\", \"aja\", \"kalo\", \"klo\", \"lu\", \"gue\", \"gw\",\n",
        "    \"nih\", \"itu\", \"ini\", \"pas\", \"ada\", \"ke\", \"di\", \"dari\", \"kok\", \"doang\",\n",
        "    \"tadi\", \"banget\", \"si\", \"deh\", \"kan\", \"pun\", \"ya\", \"yah\", \"loh\", \"apa\"\n",
        "}\n",
        "list_stopwords.update(additional_stopwords)\n",
        "\n",
        "# 3. Proteksi Kata Negasi (Penting agar makna negatif tidak hilang)\n",
        "kata_negasi = {'tidak', 'kurang', 'belum', 'gak', 'ga', 'bukan', 'jangan', 'tak'}\n",
        "for kata in kata_negasi:\n",
        "    if kata in list_stopwords:\n",
        "        list_stopwords.remove(kata)\n",
        "\n",
        "# 4. Fungsi Stopword Removal\n",
        "def remove_stopwords(text):\n",
        "    if not isinstance(text, str):\n",
        "        return \"\"\n",
        "    tokens = text.split()\n",
        "    # Menghapus kata yang masuk dalam list_stopwords\n",
        "    filtered_tokens = [word for word in tokens if word.lower() not in list_stopwords]\n",
        "    return \" \".join(filtered_tokens)\n",
        "\n",
        "# 5. Eksekusi pada DataFrame\n",
        "df['Stopword_Removal'] = df['Case_Folding'].apply(remove_stopwords)\n",
        "\n",
        "# 6. Mengambil Sampel Gabungan (5 Positif & 5 Negatif)\n",
        "df_positif_sw = df[df['label'].str.lower() == 'positif'].head(5)\n",
        "df_negatif_sw = df[df['label'].str.lower() == 'negatif'].head(5)\n",
        "\n",
        "# Menggabungkan menjadi satu tabel tunggal\n",
        "df_combined_sw = pd.concat([df_positif_sw, df_negatif_sw]).reset_index(drop=True)\n",
        "\n",
        "# 7. Menampilkan Output Final untuk Paper\n",
        "print(\"=\"*95)\n",
        "print(\"TABEL VERIFIKASI TAHAP STOPWORD REMOVAL (5 POSITIF & 5 NEGATIF)\")\n",
        "print(\"=\"*95)\n",
        "\n",
        "# Menampilkan perbandingan Case_Folding (Sebelum) dan Stopword_Removal (Sesudah)\n",
        "display(df_combined_sw[['Case_Folding', 'Stopword_Removal', 'label']])"
