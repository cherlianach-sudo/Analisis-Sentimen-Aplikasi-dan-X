        "    subsample=0.8,\n",
        "    colsample_bytree=0.8,\n",
        "    eval_metric='mlogloss',\n",
        "    random_state=42,\n",
        "    n_jobs=-1\n",
        ")\n",
        "\n",
        "# Encode target labels to numerical values\n",
        "le = LabelEncoder()\n",
        "y_encoded = le.fit_transform(y) # Encode the full 'y'\n",
        "original_labels = le.classes_ # Store the original string labels for later use\n",
        "\n",
        "# ================================\n",
        "# CROSS VALIDATION\n",
        "# ================================\n",
        "skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
        "# Use y_encoded for cross_val_predict\n",
        "y_pred_cv_xgb = cross_val_predict(xgb_model, X, y_encoded, cv=skf)\n",
        "\n",
        "# The labels variable should now correspond to the original string labels\n",
        "# retrieved from the LabelEncoder to display in the report and confusion matrix\n",
        "labels = original_labels.tolist() # Convert numpy array to list for classification_report\n",
        "\n",
        "# ================================\n",
        "# AKURASI\n",
        "# ================================\n",
        "# Calculate accuracy using y_encoded and y_pred_cv_xgb\n",
        "acc_xgb = accuracy_score(y_encoded, y_pred_cv_xgb)\n",
        "\n",
        "print(\"=\"*40)\n",
        "print(\"HASIL CROSS-VALIDATION (XGBOOST)\")\n",
        "print(\"=\"*40)\n",
        "print(f\"AKURASI CROSS-VALIDATION: {acc_xgb*100:.2f}%\")\n",
